#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_PARKINGS 100
#define MAX_STRING 100

// Structures
typedef struct {
    char id[MAX_STRING];
    char nom[MAX_STRING];
    char adresse[MAX_STRING];
    int occupation;
    int capacite;
    char etat[MAX_STRING];
} Parking;

typedef struct {
    char plaque[MAX_STRING];
    char idParking[MAX_STRING];
    time_t heureEntree;
} Vehicule;

// Variables globales
Parking parkings[MAX_PARKINGS];
int nbParkings = 0;

Vehicule vehicules[MAX_PARKINGS];
int nbVehicules = 0;

// Initialisation manuelle
void initialiserParkings() {
    nbParkings = 3;

    strcpy(parkings[0].id, "P001");
    strcpy(parkings[0].nom, "Parking Lille Centre");
    strcpy(parkings[0].adresse, "12 rue de Paris, Lille");
    parkings[0].occupation = 50;
    parkings[0].capacite = 100;
    strcpy(parkings[0].etat, "Ouvert");

    strcpy(parkings[1].id, "LIL01");
    strcpy(parkings[1].nom, "Parking Gare Lille Flandres");
    strcpy(parkings[1].adresse, "Place des Buisses, Lille");
    parkings[1].occupation = 75;
    parkings[1].capacite = 120;
    strcpy(parkings[1].etat, "Ouvert");

    strcpy(parkings[2].id, "EUR8");
    strcpy(parkings[2].nom, "Parking EuraLille");
    strcpy(parkings[2].adresse, "Boulevard Hoover, Lille");
    parkings[2].occupation = 30;
    parkings[2].capacite = 80;
    strcpy(parkings[2].etat, "Fermé");
}

// Fonctions
void afficheparking(char* id) {
    for (int i = 0; i < nbParkings; i++) {
        if (strcmp(parkings[i].id, id) == 0) {
            printf("=== Parking ID %s ===\n", id);
            printf("Nom : %s\nAdresse : %s\nCapacité : %d\nOccupées : %d\nÉtat : %s\n",
                   parkings[i].nom,
                   parkings[i].adresse,
                   parkings[i].capacite,
                   parkings[i].occupation,
                   parkings[i].etat);
            return;
        }
    }
    printf("Parking non trouvé.\n");
}

void afficheparkings() {
    for (int i = 0; i < nbParkings; i++) {
        afficheparking(parkings[i].id);
        printf("\n");
    }
}

int verifierPlacesDisponibles(char* idParking) {
    for (int i = 0; i < nbParkings; i++) {
        if (strcmp(parkings[i].id, idParking) == 0) {
            return parkings[i].occupation < parkings[i].capacite;
        }
    }
    return 0;
}

void mettreAJourOccupation(char* idParking, int entree) {
    for (int i = 0; i < nbParkings; i++) {
        if (strcmp(parkings[i].id, idParking) == 0) {
            if (entree)
                parkings[i].occupation++;
            else
                parkings[i].occupation--;
        }
    }
}

void entreeParking(char* plaque, char* idParking) {
    if (!verifierPlacesDisponibles(idParking)) {
        printf("Parking plein.\n");
        return;
    }

    strcpy(vehicules[nbVehicules].plaque, plaque);
    strcpy(vehicules[nbVehicules].idParking, idParking);
    vehicules[nbVehicules].heureEntree = time(NULL);
    nbVehicules++;

    mettreAJourOccupation(idParking, 1);
    printf("Véhicule %s entré dans le parking %s.\n", plaque, idParking);
}

double calculerMontant(time_t entree, time_t sortie) {
    double minutes = difftime(sortie, entree) / 60.0;
    return minutes * 0.05;
}

void sortieParking(char* plaque) {
    for (int i = 0; i < nbVehicules; i++) {
        if (strcmp(vehicules[i].plaque, plaque) == 0) {
            time_t sortie = time(NULL);
            double montant = calculerMontant(vehicules[i].heureEntree, sortie);
            printf("Montant à payer pour %s : %.2f €\n", plaque, montant);

            mettreAJourOccupation(vehicules[i].idParking, 0);

            // Supprimer le véhicule
            vehicules[i] = vehicules[--nbVehicules];
            return;
        }
    }
    printf("Véhicule non trouvé.\n");
}

void sauvegarderEtatParking(const char* fichier) {
    FILE* f = fopen(fichier, "w");
    if (!f) return;

    for (int i = 0; i < nbParkings; i++) {
        fprintf(f, "%s,%s,%s,%d,%d,%s\n",
                parkings[i].id,
                parkings[i].nom,
                parkings[i].adresse,
                parkings[i].occupation,
                parkings[i].capacite,
                parkings[i].etat);
    }

    fclose(f);
}

// Menu
void menu() {
    int choix;
    char plaque[MAX_STRING];
    char id[MAX_STRING];

    do {
        printf("\n MENU\n");
        printf("1. Afficher tous les parkings\n");
        printf("2. Afficher un parking\n");
        printf("3. Entrée véhicule\n");
        printf("4. Sortie véhicule\n");
        printf("0. Quitter\n");
        printf("Choix : ");
        scanf("%d", &choix);

        switch (choix) {
            case 1:
                afficheparkings();
                break;
            case 2:
                printf("ID du parking : ");
                scanf("%s", id);
                afficheparking(id);
                break;
            case 3:
                printf("Plaque : ");
                scanf("%s", plaque);
                printf("ID du parking : ");
                scanf("%s", id);
                entreeParking(plaque, id);
                break;
            case 4:
                printf("Plaque : ");
                scanf("%s", plaque);
                sortieParking(plaque);
                break;
            case 0:
                sauvegarderEtatParking("parking-metropole.csv");
                printf("Fermeture et sauvegarde terminées.\n");
                break;
            default:
                printf("Choix invalide.\n");
        }
    } while (choix != 0);
}

int main() {
    initialiserParkings();
    menu();
    return 0;
}
