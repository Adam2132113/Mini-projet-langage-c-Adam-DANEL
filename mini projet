    int dispo = verifierPlacesDisponibles(id);
    assert(dispo == 1 || dispo == 0);
    printf("[OK] test_verifierPlaces\n");
}

// Test d’entrée et de sortie de véhicule
void test_entreeSortie() {
    int id = parkings[0].id;
    char plaqueTest[] = "TEST-123";

    int occupationAvant = parkings[0].occupation;
    entreeParking(plaqueTest, id);
    assert(parkings[0].occupation == occupationAvant + 1);

    sortieParking(plaqueTest);
    assert(parkings[0].occupation == occupationAvant);

    printf("[OK] test_entreeSortie\n");
}

